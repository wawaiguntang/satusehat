{
    "name": "wawaiguntang/satusehat",
    "type": "library",
    "description": "PHP library untuk integrasi SATUSEHAT FHIR R4 API",
    "keywords": ["satusehat", "fhir", "r4", "kemkes", "php"],
    "license": "MIT",
    "authors": [
        {
            "name": "Diki Rahmad Sandi",
            "email": "wawaiguntang@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/simple-cache": "^1.0|^2.0|^3.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "php-http/mock-client": "^1.5",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Wawaiguntang\\Satusehat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wawaiguntang\\Satusehat\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
